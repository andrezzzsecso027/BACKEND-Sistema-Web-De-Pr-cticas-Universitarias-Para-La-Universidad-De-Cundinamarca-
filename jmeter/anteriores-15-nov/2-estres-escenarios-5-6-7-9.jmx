          <stringProp name="HTTPSampler.path">/api/auth/login</stringProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
        </HTTPSamplerProxy>
        <hashTree/>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="E9.2 - Verificacion de Recuperacion del Sistema" enabled="true">
          <stringProp name="HTTPSampler.path">/api/ofertas/estudiantes</stringProp>
          <stringProp name="HTTPSampler.method">GET</stringProp>
